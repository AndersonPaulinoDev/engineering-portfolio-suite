.PHONY: test fmt vet

test:
	cd projects/agentwatch/api && go test ./...
	cd projects/opstrack/api && go test ./...
	cd projects/scanstock/api && go test ./...

fmt:
	cd projects/agentwatch/api && gofmt -w .
	cd projects/opstrack/api && gofmt -w .
	cd projects/scanstock/api && gofmt -w .

vet:
	cd projects/agentwatch/api && go vet ./...
	cd projects/opstrack/api && go vet ./...
	cd projects/scanstock/api && go vet ./...
