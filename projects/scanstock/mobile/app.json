{
  "expo": {
    "name": "ScanStock",
    "slug": "scanstock",
    "version": "0.1.0",
    "scheme": "scanstock",
    "platforms": [
      "ios",
      "android",
      "web"
    ],
    "plugins": [
      "expo-router",
      "expo-secure-store",
      [
        "expo-camera",
        {
          "cameraPermission": "Allow ScanStock to scan product barcodes."
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    }
  }
}
