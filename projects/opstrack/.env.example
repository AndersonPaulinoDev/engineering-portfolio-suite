# Required. Never use the Docker/local example secret in production.
# Generate with: openssl rand -hex 32
AUTH_SECRET=
ADDR=:8081
DATABASE_URL=postgres://opstrack:opstrack@localhost:5433/opstrack?sslmode=disable
# Portfolio review only. Set false outside a local demo.
DEMO_MODE=true
PERSISTENCE=postgres
EXPO_PUBLIC_API_URL=http://localhost:8081
