    },
    "security": [
      "hashed passwords",
      "parameterized SQL",
      "server-side authorization",
      "environment-based secrets",
      "input validation",
      "request-size limits",
      "rate limiting where appropriate",
      "token expiration",
      "CORS configuration",
      "secure file upload rules",
      "no secrets in Git history"
    ]
  },
