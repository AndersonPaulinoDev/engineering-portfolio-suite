  "projects": {
    "AgentWatch": {
      "priority": 1,
      "role": "Primary flagship",
      "category": "Developer Operations / AI Agent Control Center",
      "description": "A mobile and web control center for monitoring coding agents, automated workflows, background jobs, and development tasks.",
      "demonstrates": [
        "Go concurrency",
        "Goroutines",
        "Channels",
        "Event processing",
        "WebSockets or SSE",
        "Background workers",
        "APIs",
        "Realtime mobile applications",
        "Task queues",
        "State machines",
        "Authentication",
        "Push notifications",
        "Observability",
        "Developer tooling",
        "AI workflow integration",
        "System architecture"
      ],
      "personas": [
        {
          "name": "Developer",
          "need": "Runs multiple development tools and wants visibility without continuously watching terminals."
        },
        {
          "name": "Technical Lead",
          "need": "Wants a high-level view of tasks and failures across projects."
        },
        {
          "name": "Solo Builder",
          "need": "Uses AI agents while moving between desktop and phone."
        }
      ],
      "mvp": {
        "authentication": [
          "register",
          "login",
          "logout",
          "refresh sessions"
        ],
        "projects": [
          "create project",
          "rename project",
          "archive project",
          "see project health",
          "view project activity"
        ],
        "agents": {
          "fields": [
            "id",
            "name",
            "project",
            "type",
            "state",
            "current_task",
            "started_time",
            "heartbeat",
            "latest_message"
          ],
          "states": [
            "offline",
            "idle",
            "running",
            "waiting",
            "needs_approval",
            "failed",
            "completed"
          ]
        },
        "tasks": [
          "create task",
          "assign agent",
          "see status",
          "inspect events",
          "cancel task",
          "retry failed task"
        ],
        "realtime_events": [
          "agent.connected",
          "agent.disconnected",
          "agent.started",
          "task.started",
          "task.progress",
          "task.failed",
          "task.completed",
          "approval.requested",
          "approval.accepted",
          "approval.denied"
        ],
        "mobile_inbox": [
          "failures",
          "approvals",
          "completed jobs",
          "warnings",
          "system notices"
        ],
        "approval_system": {
          "required": true,
          "actions": [
            "reject",
            "approve"
          ],
          "goal": "Allow an agent to pause and request human approval."
        }
      },
      "backend_requirements": {
        "concurrency": {
          "use_goroutines_for": [
            "agent connections",
            "event processing",
            "heartbeat monitoring",
            "notification dispatch",
            "background cleanup"
          ],
          "rule": "Do not use concurrency merely for demonstration."
        },
        "channels": [
          "event fan-out",
          "internal message passing",
          "job dispatch"
        ],
        "realtime_transport": {
          "primary": "WebSocket",
          "secondary": "Server-Sent Events"
        },
        "event_broker": {
          "required": true,
          "event_fields": [
            "ID",
            "Type",
            "ProjectID",
            "AgentID",
            "Payload",
            "CreatedAt"
          ]
        }
      },
      "stretch_features": [
        "GitHub integration",
        "Git worktree detection",
        "terminal agent bridge",
        "Codex integration",
        "Claude Code integration",
        "local agent connector",
        "task dependencies",
        "multiple users",
        "organizations",
        "usage metrics",
        "project timelines",
        "desktop notification bridge",
        "encrypted remote commands"
      ],
      "completion_definition": [
        "user can authenticate",
        "projects can be created",
        "agents can register",
        "agents can emit heartbeats",
        "agent state changes appear realtime",
        "tasks can be created",
        "task events stream to mobile",
        "approval requests work",
        "notifications have read/unread state",
        "events persist in PostgreSQL",
        "backend tests pass",
        "CI passes",
        "system runs through Docker",
        "README documents architecture",
        "demo environment contains seed data"
      ],
      "seed_data": {
        "projects": 3,
        "agents": 5,
        "tasks": 12,
        "alerts": 2,
        "approval_requests": 1,
        "historical_events": 18
      },
      "performance_target_example": "1,000 simultaneous simulated agent events"
    },
    "OpsTrack": {
      "priority": 2,
      "category": "Field Operations & Work Management Platform",
      "description": "A mobile-first operations system for technicians, maintenance teams, inspectors, and field workers.",
      "roles": [
        "worker",
        "supervisor",
        "admin"
      ],
      "mvp": {
        "work_order_fields": [
          "title",
          "description",
          "location",
          "priority",
          "assigned_employee",
          "due_date",
          "status",
          "instructions",
          "attachments",
          "completion_evidence"
        ],
        "work_order_states": [
          "new",
          "assigned",
          "accepted",
          "in_progress",
          "blocked",
          "completed",
          "verified",
          "cancelled"
        ],
        "state_transition_rule": "Invalid transitions must be rejected by the backend.",
        "mobile_features": [
          "view assigned jobs",
          "accept assignment",
          "start work",
          "add notes",
          "take photos",
          "scan QR equipment tags",
          "mark blocked",
          "complete work",
          "collect completion evidence"
        ]
      },
      "offline_first": {
        "required": true,
        "persist_locally": [
          "job data",
          "notes",
          "status changes",
          "captured evidence metadata",
          "pending updates"
        ],
        "sync_states": [
          "synced",
          "syncing",
          "pending",
          "conflict",
          "failed"
        ],
        "behavior": "Queued operations synchronize when connectivity returns."
      },
      "audit_system": {
        "required": true,
        "immutable_for_normal_users": true,
        "fields": [
          "actor",
          "action",
          "work_order",
          "timestamp"
        ]
      },
      "stretch_features": [
        "GPS arrival confirmation",
        "supervisor dashboard",
        "recurring work orders",
        "equipment records",
        "signature capture",
        "PDF service reports",
        "scheduling",
        "route optimization",
        "customer portal",
        "push notifications"
      ],
      "completion_definition": [
        "worker can authenticate",
        "work orders appear on mobile",
        "job details work offline",
        "worker can change job states",
        "invalid transitions are rejected",
        "photos can be attached",
        "QR codes can be scanned",
        "pending changes synchronize",
        "audit log records actions",
        "role permissions work",
        "tests pass",
        "CI passes",
        "project is documented"
      ],
      "seed_data": {
        "work_orders": 8,
        "workers": 3,
        "supervisors": 1,
        "include": [
          "multiple job statuses",
          "photos/placeholders",
          "audit events"
        ]
      },
      "performance_target_example": "1,000 work-order queries"
    },
    "ScanStock": {
      "priority": 3,
      "category": "Inventory & Warehouse Operations System",
      "description": "A mobile-first inventory management system focused on correct stock movement and transactional integrity.",
      "core_model": {
        "inventory_strategy": "Ledger-based inventory movements rather than directly storing only a mutable quantity.",
        "movement_examples": [
          "+100 received",
          "-5 shipped",
          "-2 damaged",
          "+1 correction"
        ],
        "current_quantity": "Calculated from inventory movements."
      },
      "mvp": [
        "create products",
        "scan products",
        "receive inventory",
        "remove inventory",
        "perform stock counts",
        "record damage",
        "record adjustments",
        "search inventory",
        "view item history"
      ],
      "product_fields": [
        "ID",
        "SKU",
        "UPC",
        "Name",
        "Description",
        "Location",
        "ReorderLevel",
        "CreatedAt",
        "UpdatedAt"
      ],
      "inventory_transaction_fields": [
        "transaction_id",
        "product_id",
        "quantity_change",
        "transaction_type",
        "user_id",
        "device_id",
        "reference",
        "timestamp",
        "idempotency_key"
      ],
      "idempotency": {
        "required": true,
        "behavior": "Duplicate requests with the same idempotency key must return the previous result instead of applying the inventory movement twice."
      },
      "conflict_handling": {
        "required": true,
        "outcomes": [
          "succeeds",
          "merges",
          "requires review",
          "fails"
        ],
        "ui_requirement": "Conflict states must be visible to users."
      },
      "stretch_features": [
        "purchase orders",
        "suppliers",
        "multi-warehouse",
        "inventory transfers",
        "reorder alerts",
        "CSV import/export",
        "cycle counts",
        "warehouse dashboards",
        "printable labels",
        "reports"
      ],
      "completion_definition": [
        "users can authenticate",
        "products can be created",
        "barcode scanning works",
        "inventory can be received",
        "inventory can be adjusted",
        "ledger records every change",
        "inventory totals derive correctly",
        "duplicate requests are idempotent",
        "offline actions synchronize",
        "conflicts are surfaced",
        "tests pass",
        "CI passes",
        "project is documented"
      ],
      "seed_data": {
        "products": 25,
        "include": [
          "inventory history",
          "warehouse locations",
          "completed counts",
          "damaged inventory",
          "receipts"
        ]
      },
      "performance_target_example": "10,000 inventory transactions"
    }
  },
  "cross_cutting_architecture": {
    "authentication": {
      "flow": [
        "email/password",
        "Go API",
        "access token",
        "refresh token",
        "Expo SecureStore"
      ],
      "backend_requirements": [
        "access-token expiration",
        "refresh tokens",
        "logout/revocation",
        "password hashing",
        "authorization middleware"
      ]
    },
    "authorization": {
      "rule": "Permissions must be enforced on the Go backend, never exclusively by the mobile UI."
    },
    "api_design": {
      "convention": "Consistent /api/v1 resource routes",
      "success_shape": {
        "data": {},
        "error": null
      },
      "error_shape": {
        "data": null,
        "error": {
          "code": "machine_readable_error_code",
          "message": "Human-readable error message"
        }
      },
      "documentation": "Each repository must contain an OpenAPI specification."
    },
    "error_handling": [
      "invalid input",
      "expired credentials",
      "missing resources",
      "duplicate requests",
      "authorization failures",
      "database failures",
      "network interruptions",
      "timeout conditions",
      "offline actions",
      "conflicting updates"
    ],
    "logging": {
      "format": "structured JSON",
      "example_fields": [
        "level",
        "request_id",
        "method",
        "path",
        "status",
        "duration_ms"
      ],
      "never_log": [
        "passwords",
        "authentication tokens",
        "private credentials"
      ]
    },
    "observability": {
      "minimum": [
        "request logging",
        "error logging",
        "health endpoint",
        "readiness endpoint",
        "request IDs"
      ],
      "endpoints": [
        "/health",
        "/ready"
