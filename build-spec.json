  "product": {
    "overview": "A small ecosystem of production-style software designed to demonstrate independent product engineering across Go backend development, Expo/mobile development, APIs, PostgreSQL, auth, realtime systems, offline-first systems, background jobs, developer tooling, AI-assisted workflows, testing, Docker, CI/CD, Linux development, product design, and technical documentation.",
    "vision": "Create a portfolio that proves the developer can take an operational problem, design the system, build the backend, build the client, handle real-world states and failures, test it, document it, and deliver a functioning product.",
    "positioning": "Product-minded full-stack software engineer with strong Go backend, mobile, systems, automation, AI-tooling, and operational software experience.",
    "quality_bar": {
      "avoid": [
        "tutorial",
        "hackathon prototype",
        "frontend mockup",
        "AI-generated dashboard",
        "CRUD demo",
        "unfinished SaaS clone"
      ],
      "target": "A small production application built by one engineer."
    },
    "primary_outcome": "Build three credible software products that provide strong evidence of Go, Expo/mobile, backend, systems, database, and product-engineering ability."
  },
